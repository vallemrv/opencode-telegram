# Environment Variables
# Copy this file to .env and fill in your values

# ─── Telegram ────────────────────────────────────────────────────────────────
# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKENS=

# Comma-separated list of Telegram user IDs allowed to use the bot
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Admin user ID who receives notifications about unauthorized access attempts
# Example: ADMIN_USER_ID=123456789
ADMIN_USER_ID=

# If true, the process exits when an unauthorized user tries to use the bot
AUTO_KILL=false

# ─── OpenCode ────────────────────────────────────────────────────────────────
# Path to the opencode binary. Required when the process manager (systemd/PM2) runs without
# the user's PATH (e.g. installed via nvm). Run: which opencode  to get the value.
OPENCODE_CMD=/home/valle/.nvm/versions/node/v22.22.0/bin/opencode

# Default model to use for new agents (provider/model-id)
OPENCODE_DEFAULT_MODEL=github-copilot/claude-sonnet-4.6

# Host address to bind opencode servers to (default: 0.0.0.0)
# Use 127.0.0.1 if you don't want the servers reachable outside localhost
OPENCODE_BIND_HOST=0.0.0.0

# ─── Workspace ───────────────────────────────────────────────────────────────
# Root directory shown in the /proyectos browser.
# Supports ~ expansion.
# Default: ~/proyectos
WORKSPACE_DIR=~/proyectos

# Maximum number of simultaneous running OpenCode servers.
# When the limit is reached the least-recently-used server is stopped automatically.
MAX_OPENCODE_SERVERS=5

# ─── Gitea ───────────────────────────────────────────────────────────────────
# URL of your Gitea instance
# Example: http://192.168.1.100:3000
GITEA_URL=

# Gitea personal access token (Settings → Applications → Access Tokens)
GITEA_TOKEN=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# GitHub personal access token (for repo creation and credential injection)
GITHUB_TOKEN=

# ─── UI & Media ──────────────────────────────────────────────────────────────
# Auto-delete timeout for confirmation messages in milliseconds (0 = disable)
MESSAGE_DELETE_TIMEOUT=10000

# Temporary directory for uploaded files
MEDIA_TMP_LOCATION=/tmp/telegramcoder_media

# Set to true to clean up the media directory on startup
CLEAN_UP_MEDIADIR=false
