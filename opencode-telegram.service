[Unit]
Description=OpenCode Telegram Bot - AI-powered coding assistant
After=network.target

[Service]
Type=simple
User=valle
WorkingDirectory=/home/valle/proyectos/opencode-telegram
ExecStart=/usr/bin/node dist/cli.js
Restart=on-failure
RestartSec=10
# Exit code 0 = intentional stop (e.g. duplicate token 409), do not restart
EnvironmentFile=/home/valle/proyectos/opencode-telegram/.env
StandardOutput=append:/home/valle/proyectos/opencode-telegram/logs/bot.log
StandardError=append:/home/valle/proyectos/opencode-telegram/logs/bot.log

[Install]
WantedBy=multi-user.target
